# --- required ---
GROQ_API_KEY=
TAVILY_API_KEY=

# --- optional (defaults shown) ---
FACTCHECK_MODEL_NAME=openai/gpt-oss-20b
LLM_REASONING_EFFORT=low        # low | medium | high | (empty = model default). gpt-oss only.
LLM_TIMEOUT=20                  # seconds per Groq call

RETRIEVER=lite                  # lite (Arda's optimised module, default) | tavily (snippets only) | arda (old heavy pipeline)
# Tuning for RETRIEVER=lite (read by retrieval_demo_lite itself):
# LITE_QUERY_COUNT=3            # fewer Tavily queries = faster (2 is a good trade-off)
# LITE_FETCH_SOURCE_LIMIT=8     # pages downloaded per claim
# LITE_REQUEST_TIMEOUT=8        # seconds per page download
TAVILY_DEPTH=basic              # basic | advanced
MAX_SOURCES=5

MAX_VERIFIABLE_CLAIMS=8         # extra claims are skipped, not silently dropped
CLAIM_CONCURRENCY=4             # claims processed at the same time
EXTRACT_TIMEOUT=20
CLAIM_TIMEOUT=30
TOTAL_TIMEOUT=45                # /verify ALWAYS answers within this many seconds
CACHE_TTL_SECONDS=21600

EXPOSE_ERROR_DETAIL=0           # legacy: public API always hides internal errors
FRONTEND_ORIGIN=                # extra allowed CORS origin
LOG_LEVEL=INFO

APP_ENV=production
CORS_ORIGINS=https://verify-test-swart.vercel.app
TRUSTED_PROXY_CIDRS=            # verified ingress CIDRs only; never 0.0.0.0/0
MAX_ACTIVE_VERIFICATIONS=2
MAX_BACKGROUND_THREADS=8
MAX_RSS_MB=384
RATE_LIMIT_PER_MINUTE=10
HOURLY_QUOTA=100
DAILY_QUOTA=500
GLOBAL_DAILY_QUOTA=1000
MAX_TRACKED_CLIENTS=10000
